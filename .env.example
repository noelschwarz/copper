# Aloy API environment variables.
# Copy to .env and edit. The API server reads these at startup.

# Postgres connection string. Use this format for local docker-compose.
DATABASE_URL=postgresql://aloy:aloy@localhost:5432/aloy

# When false (default), the API does not require an Authorization header.
# Set to true in any environment that is reachable by anyone other than you.
USE_DB_AUTHENTICATION=false

# One of: debug, info, warn, error.
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins. Use * only in local dev.
CORS_ORIGINS=*

# HTTP port the API listens on.
PORT=3000
