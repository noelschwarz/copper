{
  "name": "copper",
  "version": "0.1.0",
  "description": "See what your AI agent is actually doing. One line, zero infra.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "author": "noelschwarz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noelschwarz/copper.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "agent",
    "observability"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "copper": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write .",
    "example:fs": "tsx examples/mcp-filesystem.ts"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^22.14.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
